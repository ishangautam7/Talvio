  "private": true,
  "type": "module",
  "description": "Tooling to generate Talvio logo assets at standard sizes",
  "scripts": {
    "build:talvio": "node talvio/build-all.mjs",
    "build:talvio-masters": "node talvio/build-masters.mjs",
    "verify:talvio": "node talvio/verify.mjs",
