            "pages": [
              "writing/ai-cleanup",
              "writing/writing-styles",
              "writing/generate-with-flow"
            ]
          },
          {
            "group": "Meetings",
            "pages": ["meetings/recording", "meetings/notes"]
          }
        ]
      },
      {
